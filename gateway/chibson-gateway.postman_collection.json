              ]
            },
            "description": "404: ninguna ruta del gateway la atiende."
          }
        }
      ]
    },
    {
      "name": "2. CORS",
      "item": [
        {
          "name": "Preflight desde Live Server (permitido)",
          "request": {
            "method": "OPTIONS",
            "header": [
              {
                "key": "Origin",
                "value": "http://127.0.0.1:5500"
              },
              {
                "key": "Access-Control-Request-Method",
                "value": "POST"
              },
              {
                "key": "Access-Control-Request-Headers",
                "value": "content-type,x-rut-usuario"
              }
            ],
            "url": {
              "raw": "{{base}}/api/productos",
              "host": [
                "{{base}}"
              ],
              "path": [
                "api",
                "productos"
              ]
            },
            "description": "200 con Access-Control-Allow-Origin: http://127.0.0.1:5500. Así pregunta el navegador antes de un fetch."
          }
        },
        {
          "name": "Preflight desde otro origen (rechazado)",
          "request": {
            "method": "OPTIONS",
            "header": [
              {
                "key": "Origin",
                "value": "http://sitio-ajeno.com"
              },
              {
                "key": "Access-Control-Request-Method",
                "value": "GET"
              }
            ],
            "url": {
              "raw": "{{base}}/api/productos",
              "host": [
                "{{base}}"
              ],
              "path": [
                "api",
                "productos"
              ]
            },
            "description": "403 Invalid CORS request: ese origen no está en la lista."
          }
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "base",
      "value": "http://localhost:8080"
    },
    {
      "key": "rutAdmin",
      "value": "12345678-5"
    }
  ]
}