{
  "info": {
    "name": "Chibson · API Gateway",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Comprueba que el gateway (8080) reenvía a cada microservicio y que CORS responde bien."
  },
  "item": [
    {
      "name": "1. Rutas",
      "item": [
        {
          "name": "ms-usuarios: login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base}}/api/auth/login",
              "host": [
                "{{base}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "description": "200 desde ms-usuarios (8081).",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"correo\": \"admin@chibson.cl\",\n  \"password\": \"Admin1234\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "ms-usuarios: notificaciones del admin",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-Rut-Usuario",
                "value": "{{rutAdmin}}"
              }
            ],
            "url": {
              "raw": "{{base}}/api/notificaciones",
              "host": [
                "{{base}}"
              ],
              "path": [
                "api",
                "notificaciones"
              ]
            },
            "description": "200."
          }
        },
        {
          "name": "ms-productos: catálogo",
