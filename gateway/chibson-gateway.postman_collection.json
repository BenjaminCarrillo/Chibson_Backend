        {
          "name": "Ruta inexistente",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base}}/api/no-existe",
              "host": [
                "{{base}}"
              ],
