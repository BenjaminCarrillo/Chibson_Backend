        "body": {
          "mode": "raw",
          "raw": "{\n  \"titulo\": \"Llegaron las cápsulas Vintage Alnico V\",\n  \"contenido\": \"Ya llegaron las pastillas Alnico V. Stock limitado.\",\n  \"imagenUrl\": \"img/noticia2.jpg\",\n  \"categoria\": \"ANUNCIO\"\n}",
