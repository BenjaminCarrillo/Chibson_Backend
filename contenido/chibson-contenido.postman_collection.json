{
  "info": {
    "name": "Chibson · ms-contenido",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Pruebas de las HU-74 a HU-80. Ejecutar en orden con la base vacía y con ms-usuarios corriendo (el administrador 12345678-5 se crea solo al levantarlo)."
  },
  "variable": [
    {
      "key": "base",
      "value": "http://localhost:8085"
    },
    {
      "key": "rutAdmin",
      "value": "12345678-5"
    }
  ],
  "item": [
    {
      "name": "1. Publicar noticia (HU-76)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "X-Rut-Usuario",
            "value": "{{rutAdmin}}"
          }
        ],
        "url": {
          "raw": "{{base}}/api/noticias",
          "host": [
            "{{base}}"
          ],
          "path": [
            "api",
            "noticias"
          ]
        },
        "description": "Debe responder 201 con estado ACTIVADA y fechaPublicacion de hoy.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"titulo\": \"Nuevas cápsulas Vintage Alnico V\",\n  \"contenido\": \"Ya llegaron las pastillas Alnico V para guitarras eléctricas.\",\n  \"imagenUrl\": \"img/noticia2.jpg\",\n  \"categoria\": \"ANUNCIO\",\n  \"publicar\": true\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
